    "react-router-dom": "^6.22.1",
    "react-select": "^5.8.0",
    "react-type-animation": "^3.2.0",
    "recharts": "^2.12.0",
    "rollup": "^4.53.3",
    "vite-plugin-pwa": "^1.2.0",
    "vite-react-ssg": "^0.9.1-beta.1"
