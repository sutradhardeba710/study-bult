{
  "name": "study-vault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build",
    "build:with-types": "tsc -b && vite-react-ssg build",
    "lint": "eslint .",
    "preview": "vite preview",
    "analyze": "vite build --mode analyze",
    "optimize-images": "node scripts/optimize-images.js",
    "clean": "rimraf dist",
    "build:prod": "npm run clean && npm run optimize-images && npm run build && npm run generate:sitemap",
    "generate:sitemap": "node server/react-vite-sitemap-generator.js",
    "submit:sitemap": "node server/google-search-console-api.js",
    "index:urls": "node server/google-indexing-api.js",
    "deploy:seo": "npm run generate:sitemap && npm run submit:sitemap && npm run index:urls"
  },
