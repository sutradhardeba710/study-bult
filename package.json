    "@firebase/auth": "^1.5.1",
    "@firebase/firestore": "^4.4.0",
    "@firebase/functions": "^0.13.1",
    "@firebase/storage": "^0.14.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react-easy-crop": "^1.16.0",
    "axios": "^1.6.7",
    "canvas-confetti": "^1.9.4",
